{
  "name": "rackbops-discord-bot",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.4.3",
  "description": "Discord bot: a plugin host with GitHub release announcements and in-place self-update",
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch run src/index.ts",
    "check": "bunx tsc --noEmit"
  },
  "dependencies": {
    "discord.js": "^14.27.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "typescript": "^7.0.0"
  },
  "overrides": {
    "undici": "^7.29.0"
  }
}
