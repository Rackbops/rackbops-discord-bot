{
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "types": ["bun-types"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    // #136: catches an unused local, param, or import/type-import, aliased or not -- EXCEPT an
    // import whose local name starts with `_` (`import { X as _y }`): TypeScript treats that as
    // deliberately unused, as it does a `_param`. A `_`-prefixed local `const` is still flagged.
    // Nothing in this repo today catches that case; eslint's no-unused-vars would, if ever added.
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src", "test"]
}
