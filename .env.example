# Discord (required)
DISCORD_TOKEN=your-bot-token
ANNOUNCE_CHANNEL_ID=123456789012345678
# Separate channel for release announcements (optional; falls back to ANNOUNCE_CHANNEL_ID)
RELEASE_ANNOUNCE_CHANNEL_ID=
# Register slash commands to a single Discord server for instant availability (optional;
# omitting registers globally, which can take up to an hour to propagate). Right-click the
# server icon -> Copy Server ID, with Developer Mode enabled.
DISCORD_SERVER_ID=
# Prefix for slash-command names, e.g. r_ → /r_dmf, /r_reset, /r_status. Set this to run a
# second (debug/staging) bot in the same server without command collisions. Lowercase
# letters/numbers/-/_ only (Discord rule); leave blank for the normal command names.
COMMAND_PREFIX=

# GitHub repo the bot lives in and self-updates against (BOT_BRANCH is a branch on it).
GITHUB_REPO=Rackbops/rackbops-discord-bot
# Repos whose releases get announced — comma-separated owner/repo. Leave blank to watch
# just GITHUB_REPO (the default). Example: Rackbops/rackbops-discord-bot,roshne/ActionBarMaster
WATCHED_REPOS=
# GitHub token. Optional for release polling (raises the rate limit); REQUIRED for /report,
# where it must have issues:write on the reportable repos (a roshne PAT covers wow + abm).
GITHUB_TOKEN=

# Discord role ID allowed to use /report — required to enable /report. Right-click the role
# -> Copy Role ID (Developer Mode on). Unset -> /report replies that it isn't configured.
REPORT_ROLE_ID=

# Self-update. Discord user IDs allowed to run /update (comma-separated; empty = nobody).
# Right-click a user -> Copy User ID, with Developer Mode enabled.
ADMIN_USER_IDS=
# Update automatically when a newer bot build exists, instead of waiting for /update. With the
# default (socket-mounted) compose this is an UNATTENDED rebuild-from-GitHub + swap every ~15 min,
# so anyone who can push to BOT_BRANCH then effectively has root on this box (see the README's
# self-update "What it costs"). Without the socket it degrades to an exit 75 for a supervisor to
# rebuild/pull on respawn. Off by default.
AUTO_UPDATE=false
# Branch staleness is measured against (default main). Must exist on GITHUB_REPO — a
# local-only branch can't be queried. Point a staging deploy at its own pushed branch.
BOT_BRANCH=main
# GIT_SHA is baked in at image build (see docker-compose.yml), not set here.

# Plugins — installed from a published manifest (see docs/adr/0004, epic #95). Comma-separated
# plugin names, optionally name@version to pin a version (e.g. warbandeer,foo@1.2.3). Empty =
# no plugins installed. Takes effect on the next restart/recreate.
PLUGINS=
# Where to fetch the Plugin Index (plugins.json) from. Accepts an http(s) URL, a file:// URL, or
# an absolute path. Defaults to the Rackbops/rackbops-bot-plugins repo's published manifest.
PLUGIN_INDEX_URL=
# Development only: override the npm registry base plugin bundles are resolved/downloaded from
# (default https://registry.npmjs.org). For pointing the end-to-end fixture-plugin flow at a local
# registry stub. Leave unset in production.
PLUGIN_REGISTRY_URL=

# Used by the warbandeer plugin (set PLUGINS=warbandeer above). Character linking (/link,
# /unlink): the port the plugin's ingest server binds inside the container — pick any free one.
# Unset -> the connector doesn't start and /link reports itself disabled. Never published to the
# host; reachable only through the Cloudflare Tunnel below (see README's "Character linking").
WARBANDEER_INGEST_PORT=

# Used by the wow plugin (set PLUGINS=...,wow above) — the WoW features (/dmf, /reset, /status,
# /transmog, and the Darkmoon Faire / weekly-reset / realm-watch announcements). All optional:
#   WOW_REGION      us | eu — drives reset times and the Darkmoon Faire timezone default.
#   WOW_REALM       realm slug the up/down watch tracks + /status reports; blank = no realm watch.
#   DMF_TIMEZONE    override the Darkmoon Faire timezone (default from WOW_REGION).
#   BLIZZARD_*      client credentials from https://develop.battle.net — without them /status,
#                   /transmog, and the realm watch are disabled.
WOW_REGION=
WOW_REALM=
DMF_TIMEZONE=
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=

# Cloudflare Tunnel token, for exposing the bot's local API (WARBANDEER_INGEST_PORT above)
# without opening inbound firewall ports. Only needed if running `docker compose --profile
# tunnel up`. Get one from the Cloudflare Zero Trust dashboard -> Networks -> Tunnels ->
# create a tunnel -> Docker connector -> copy the token.
CLOUDFLARE_TUNNEL_TOKEN=

# Cloudflare Access JWT verification for the admin panel's door 2 (`docker compose --profile
# admin up`) — optional; leave both blank to keep ADMIN_TOKEN below as the only door-2 check
# (e.g. before Access is set up for this instance). When both are set, the panel verifies
# Access's own signed JWT (the Cf-Access-Jwt-Assertion header Access attaches once a request has
# passed through it) against Cloudflare's published JWKS, and ADMIN_TOKEN becomes a fallback for
# when that verification can't run (JWKS unreachable) rather than the only check.
# These two (and ADMIN_ALLOWED_EMAILS/ADMIN_TOKEN below) are read once, into the admin
# container's own process env, when `--profile admin up` runs (ops/install.sh's printed step 4)
# — the container never re-reads this file. Filling them in for the first time after bring-up,
# or changing either later, does nothing to the running panel until that command is re-run with
# the new values exported into the shell.
# Team domain: Zero Trust dashboard -> Settings -> General -> "Team domain" (just the
# *.cloudflareaccess.com value, no https:// prefix).
CLOUDFLARE_ACCESS_TEAM_DOMAIN=
# AUD tag: Zero Trust dashboard -> Access -> Applications -> (this admin panel's application) ->
# Overview -> "Application Audience (AUD) Tag".
CLOUDFLARE_ACCESS_AUD=
# Optional narrowing on top of the JWT check above: comma-separated emails allowed to actually
# use this panel, checked against the verified JWT's own email claim. Matters when your Access
# app's policy is shared with other tools (e.g. the same "Allow trusted users" policy also gates
# Dockge) — this restricts who can act on THIS bot specifically, without touching that shared
# policy. These are the PERMANENT bootstrap admins (editable only here on the box — and, like
# the Access vars above, only takes effect on the running panel once the admin container is
# recreated via install.sh's step 4, not just by saving this file); more can be added/removed
# live from the panel's Admins section, persisted to admins.json beside this file.
# With this blank AND no panel-added admins, any identity Access's own policy lets through is
# allowed; once either list has an entry, narrowing is on. Never applied to the ADMIN_TOKEN
# fallback below, which stays identity-blind — it's the break-glass path for when JWT auth can't
# run at all.
ADMIN_ALLOWED_EMAILS=

# Bearer token gating the admin panel's API (`docker compose --profile admin up`) — door 2,
# behind Cloudflare Access as door 1 (see ops/README.md). ops/install.sh generates this itself
# on first bootstrap (it isn't tied to any external account, unlike the secrets above); leave it
# to that unless you're rotating it by hand. Always required regardless of the Access vars
# above — it's what still authorizes a request if CLOUDFLARE_ACCESS_TEAM_DOMAIN/
# CLOUDFLARE_ACCESS_AUD aren't set yet, or if Cloudflare's JWKS endpoint is briefly unreachable.
# Rotating the value here does NOT revoke the old one: the running panel keeps accepting it —
# same read-once-at-container-start rule as the Access vars above — until the admin container is
# recreated (re-run install.sh's step 4 with the new ADMIN_TOKEN exported). If this token has
# leaked, edit it here AND recreate; editing alone leaves the leaked token working.
ADMIN_TOKEN=
